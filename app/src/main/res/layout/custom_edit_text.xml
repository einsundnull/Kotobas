<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/custom_edit_text"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="32dp"
    android:layout_marginBottom="248dp"
    android:gravity="center"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toStartOf="@+id/btn_add_lesson"
    app:layout_constraintHorizontal_bias="0.0"
    app:layout_constraintStart_toStartOf="parent">


<com.google.android.material.textfield.TextInputEditText
    android:id="@+id/custom_edit_text_input"
    android:layout_width="0dp"
    android:layout_height="60dp"
    android:layout_marginTop="-11dp"
    android:background="@drawable/input_border_label"
    android:gravity="center"

    android:tag="New Lesson Name"
    android:text="New Lesson Name"
    android:textSize="24sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="@+id/custom_edit_text"
    app:layout_constraintTop_toBottomOf="@+id/custom_edit_text" />
</androidx.constraintlayout.widget.ConstraintLayout>
<!--    android:inputType="number"-->