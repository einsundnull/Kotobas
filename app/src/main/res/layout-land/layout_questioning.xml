<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/questioning_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/activity_main_scene"
    tools:context="com.notorein.BasicAppII.ActivityMain">
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/menuIconEditCard"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnLeft" />

    <TextView
        android:id="@+id/menuIconAdNewCard"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnSetToEnd" />

    <TextView
        android:id="@+id/hintMode2"
        android:layout_width="47dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="21dp"
        android:textAlignment="center"
        android:textSize="8sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hintMode"
        tools:ignore="SmallSp" />



    <TextView
        android:id="@+id/questionTxtView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="200dp"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="200dp"
        android:width="300dp"
        android:fontFamily="@font/roboto_black"
        android:maxLines="9"
        android:singleLine="false"
        android:textAlignment="center"
        android:textSize="19sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/questionTxtVwII"
        android:singleLine = "false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="200dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="200dp"
        android:width="300dp"
        android:fontFamily="@font/roboto_black"
        android:maxLines="9"
        android:textAlignment="center"
        android:textSize="12sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionTxtView" />

    <TextView
        android:id="@+id/answerTxtVw"
        android:singleLine = "false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="200dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="200dp"
        android:fontFamily="@font/roboto_black"
        android:maxLines="9"
        android:textAlignment="center"
        android:textColor="#37383b"
        android:textSize="12sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/questionTxtView" />


    <TextView
        android:id="@+id/menuIcon"
        android:layout_width="47dp"
        android:layout_height="80dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:textColor="#37383b"
        android:textSize="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="47dp"
        android:layout_height="47dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="21dp"
        android:fontFamily="@font/abhaya_libre_extrabold"
        android:textAlignment="center"
        android:textColor="#37383b"
        android:textSize="45sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/hintDirection"
        android:layout_width="47dp"
        android:layout_height="20dp"
        android:layout_marginEnd="21dp"
        android:textAlignment="center"
        android:textColor="#37383b"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint" />


    <TextView
        android:id="@+id/hintMode"
        android:layout_width="47dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="21dp"
        android:textAlignment="center"
        android:textColor="#212224"
        android:textSize="8sp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hintDirection" />

    <TextView
        android:id="@+id/btnLeft"
        android:layout_width="210dp"
        android:layout_height="95dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="ButtonStyle,SpeakableTextPresentCheck" />

    <TextView
        android:id="@+id/btnSetToEnd"
        android:layout_width="74dp"
        android:layout_height="95dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="8dp"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnRight"
        tools:ignore="ButtonStyle,SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/btnRight"
        android:layout_width="210dp"
        android:layout_height="95dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        tools:ignore="ButtonStyle,SpeakableTextPresentCheck" />

    <LinearLayout
        android:id="@+id/btnContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="invisible"></LinearLayout>






</androidx.constraintlayout.widget.ConstraintLayout>